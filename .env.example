DATABASE_URL=postgresql://user:password@host:port/database
JWT_SECRET=your-super-secret-key-change-this-in-production
NODE_ENV=production
PORT=3000

# Email Configuration
# OPTION 1: SendGrid HTTP API (RECOMMENDED for Railway/cloud hosting)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# OPTION 2: SMTP (for local development or alternative SMTP providers)
# NOTE: Railway blocks SMTP ports - use SendGrid API instead
# For Gmail: smtp.gmail.com, port 587, secure=false
# For Outlook: smtp-mail.outlook.com, port 587, secure=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM_NAME=ITB Bid System
SMTP_FROM_EMAIL=noreply@yourdomain.com

FRONTEND_URL=https://your-railway-app.up.railway.app